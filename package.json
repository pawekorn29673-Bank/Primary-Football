{
  "name": "matchday-league-manager",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:schedule": "tsc --target es2020 --module commonjs --skipLibCheck --outDir .league-test-build lib/league.ts lib/ui-text.ts && node tests/league.test.js",
    "test:smoke": "npm run test:schedule && node tests/render-smoke.js"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "lucide-react": "1.64.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.15.30",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
